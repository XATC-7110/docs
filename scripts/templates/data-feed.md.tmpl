reasons_intro = The main reasons:
reason_line = - $reason: $count
airports_change_up = ($n more airports are missing at least one approach than at $since.)
airports_change_down = ($n fewer airports are missing an approach than at $since.)
fixes_change_up = That is $n more than at $since.
fixes_change_down = That is $n fewer than at $since.
up_since = up $n since $since
down_since = down $n since $since
new_since = new since $since
changed_since = changed since $since
fixed_since = fixed since $since
more_rows = and $n more not shown here
table_none = None.
no_longer_heading = ## No longer on the lists
no_longer_intro = These airports were on the lists at $since and are not now.
no_longer_was_runway = a runway had no approach
no_longer_was_circling = only circling approaches were missing
no_longer_was_some = some approaches were missing
airport_one = $n airport
airport_many = $n airports
changed_none = What changed: nothing on the lists or in the confirmed fix names has changed since $since.
changed_some = What changed since $since: $new_airports newly listed, $fixed_airports fixed, $changed_airports changed, and $fix_change.
fix_change_up = $n more fix names confirmed
fix_change_down = $n fewer fix names confirmed
